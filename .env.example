# ── Supabase (client + server) ───────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=            # Supabase project URL, e.g. https://xxxx.supabase.co — used by the browser client, Core's db/storage adapters, and Core.createAuthClient()
NEXT_PUBLIC_SUPABASE_ANON_KEY=       # Supabase anon/public API key — used by the browser client and Core.createAuthClient() (request-scoped, cookie-bound; never cached)
SUPABASE_URL=                        # Fallback for NEXT_PUBLIC_SUPABASE_URL (non-public contexts)
SUPABASE_ANON_KEY=                   # Fallback for NEXT_PUBLIC_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=           # Declared in src/config/env.ts; currently unused by any code path — kept for a future server-side use, not consumed today
SUPABASE_SERVICE_KEY=                # Service-role key — used by Core's SupabaseAdapter (lib/db) and SupabaseStorageAdapter (lib/storage), both long-lived singletons

# ── Auth (src/lib/auth-crypto.ts, src/lib/auth-actions.ts) ────────────────
PASSWORD_SECRET_KEY=                 # Secret used to encrypt/verify stored passwords (HMAC-SHA256)

# ── Auth (src/app/actions/auth.actions.ts, src/app/auth/confirm/route.ts) ─
NEXT_PUBLIC_SITE_URL=http://localhost:3000  # Base URL used to build the resetPasswordForEmail redirectTo link — set to the deployed origin in production

# ── Migration CLI (src/lib/migrate.ts, src/db/migrationmanager.ts) ────────
DATABASE_URL=                        # postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres — also used by Core.db when DB_ADAPTER="sql"
SUPABASE_DB_PASSWORD=                # Alternative to DATABASE_URL: paired with NEXT_PUBLIC_SUPABASE_URL to build it

# ── Core (src/lib/core) — DB layer is fully provider-agnostic ────────────
DB_ADAPTER=supabase                  # "supabase" (REST API) or "sql" (raw Postgres via DATABASE_URL) — swapping this never touches lib/db call sites
DB_CACHE_ENABLED=false               # Wraps db in CachingExtension (in-memory, read-through)
DB_AUDIT_ENABLED=false               # Wraps db in AuditExtension (writes to public.audit_logs — no migration ships that table yet; add one before enabling this)
DB_SOFT_DELETE_ENABLED=false         # Wraps db in SoftDeleteExtension (flags deleted_at instead of deleting)
DB_ENCRYPTION_ENABLED=false          # Wraps db in EncryptionExtension (AES-256-GCM on configured fields — none configured yet, see ENCRYPTED_FIELDS in buildCoreConfigFromEnv.ts)
ENCRYPTION_KEY=                      # Required when DB_ENCRYPTION_ENABLED=true — MUST be exactly 32 characters (bytes, UTF-8)

# ── Core (src/lib/core) — Storage layer is fully provider-agnostic ───────
STORAGE_ADAPTER=supabase             # "supabase" today; STORAGE_ADAPTERS leaves room for "r2"/"s3" later without touching lib/storage call sites
